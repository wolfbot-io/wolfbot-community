{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://community.wolfbot.io/schemas/broker-capabilities-v1.json",
  "title": "WolfBot Community — Broker Capability Manifest Schema",
  "description": "Schema for the broker-capabilities.json file that drives the community.wolfbot.io/brokers page. Implements Sections 21-22, 144-145 of the Community Brand/SEO/Growth Master Plan V2.",
  "type": "object",
  "required": ["schema_version", "generated_at", "brokers"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "description": "Schema version for forward compatibility",
      "const": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when this manifest was generated"
    },
    "certified_version": {
      "type": "string",
      "description": "WolfBot Community version this certification applies to",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[a-z0-9.]+)?$"
    },
    "brokers": {
      "type": "object",
      "description": "Per-broker capability entries",
      "additionalProperties": {
        "type": "object",
        "required": ["name", "display_name", "overall_status", "platforms", "capabilities"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Broker identifier key"
          },
          "display_name": {
            "type": "string",
            "description": "Human-readable broker display name"
          },
          "overall_status": {
            "type": "string",
            "enum": ["stable", "beta", "experimental", "unsupported"],
            "description": "Overall support status"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["linux", "windows"]
            }
          },
          "capabilities": {
            "type": "object",
            "properties": {
              "demo": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "live": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "market_order": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "limit_order": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "tp_sl": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "dca": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "hedge_mode": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "terminal": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]},
              "strategy": {"type": "string", "enum": ["stable", "beta", "experimental", "unsupported"]}
            }
          },
          "certified_version": {"type": ["string", "null"]},
          "last_certified": {"type": ["string", "null"], "format": "date"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
