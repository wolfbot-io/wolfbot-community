{
  "name": "wolfbot-community",
  "version": "0.1.0",
  "private": true,
  "description": "WolfBot Community — Free self-hosted trading automation website. Built with Next.js.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run prebuild-content && next build && npm run fix-html-lang",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "sitemap": "tsx scripts/generate-sitemap.ts",
    "rss": "tsx scripts/generate-rss.ts > public/rss.xml",
    "llms": "tsx scripts/generate-llms-txt.ts",
    "search-index": "tsx scripts/generate-search-index.ts",
    "fix-html-lang": "tsx scripts/fix-html-lang.ts",
    "prebuild-content": "npm run sitemap && npm run rss && npm run llms && npm run search-index",
    "freshness": "tsx scripts/check-content-freshness.ts --current-version 0.1.0-p12-ghcr-rc21 --max-age 90",
    "metrics": "python3 scripts/collect_github_metrics.py"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.0",
    "@mdx-js/react": "^3.0.0",
    "@next/mdx": "^14.2.0",
    "autoprefixer": "^10.5.4",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.26",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-markdown": "^9.0.3",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
