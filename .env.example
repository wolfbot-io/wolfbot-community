# wolfbot-community compose project env (COMPOSE_PROJECT_NAME=wolfbot-community).
# Copy to `.env` in this directory before `docker compose up` -- only the
# `relay` service (WOLFBOT_COMMUNITY_TRADINGVIEW_RELAY_PLAN_V1.md sec 3, the
# Hosted Community Relay backend for https://community.wolfbot.io) reads
# these; the `community` static marketing site needs none of them.

# Product image that already contains the relay routes (same image every
# Community install runs; here it just boots in APP_ENV=relay mode).
WOLFBOT_RELAY_IMAGE=ghcr.io/wolfbot-io/wolfbot-webui:0.1.0-beta.2

# Public HTTPS origin TradingView/local Community agents will reach. Leave
# as the real community.wolfbot.io domain unless this is a staging deploy.
WOLFBOT_RELAY_PUBLIC_BASE_URL=https://community.wolfbot.io

# Required, no default on purpose -- generate a real long random string for
# each (e.g. `openssl rand -hex 32`). Never reuse wolfbot-platform's own
# SECRET_KEY/JWT_SECRET_KEY here; this is a separate, lower-trust service
# that never sees broker credentials or tenant data.
WOLFBOT_RELAY_SECRET_KEY=change-this-long-random-string
WOLFBOT_RELAY_JWT_SECRET_KEY=change-this-other-long-random-string
