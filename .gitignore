# wolfbot-community git submodule
# This repo is the public-facing GitHub repository for WolfBot Community.

# dependencies
node_modules/
.next/

# build output
out/
dist/

# env
.env
.env.local
.env.production

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# analytics data (local snapshots)
analytics/*.json
!analytics/.gitkeep

# scripts output
scripts/output/

# generated at build time by `npm run prebuild-content`
# (scripts/generate-sitemap.ts, scripts/generate-rss.ts) — regenerated on
# every deploy build, do not commit a stale copy
public/sitemap.xml
public/rss.xml

# Next.js build cache
next-env.d.ts
*.tsbuildinfo
